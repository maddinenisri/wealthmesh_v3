# Copy to .env (git-ignored). Read by ecosystem.config.cjs and scripts/db.sh.
DB_PASSWORD=change-me

# Ports; the defaults avoid clashing with wealthmesh_v2 (8080 / 5173 / 5433).
WM_DB_PORT=5434
WM_BACKEND_PORT=8081
WM_FRONTEND_PORT=5180   # dev server only; the fat jar serves the UI on WM_BACKEND_PORT

# Optional: JDK 25 home, if it is not found through JAVA_HOME, jenv or java_home.
# WM_JAVA_HOME=/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home
